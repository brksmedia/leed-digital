---
import { FOOTER_GROUPS, SITE } from '../config/site'
---

<footer class="site-footer">
  <div class="footer-identity">
    <a class="footer-brand" href="/" aria-label="LEED Digital, página inicial">LEED<span>.</span></a>
    <p>{SITE.positioning}</p>
    <p class="footer-meta">© 2026 LEED Digital</p>
  </div>

  <nav class="footer-map" aria-label="Mapa do site">
    {FOOTER_GROUPS.map((group) => (
      <section class="footer-group">
        <h2>{group.title}</h2>
        <ul>
          {group.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: minmax(240px, 1.2fr) minmax(0, 2.8fr);
    gap: clamp(56px, 8vw, 140px);
    padding: clamp(64px, 8vw, 112px) clamp(24px, 6vw, 96px);
    color: var(--paper-bright, #f8f6ef);
    background: var(--ink, #151714);
    border-top: 1px solid rgba(248, 246, 239, .18);
  }

  .footer-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .footer-brand {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: inherit;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.09em;
    text-decoration: none;
  }

  .footer-brand span { color: var(--blue, #1557ff); }

  .footer-identity > p:not(.footer-meta) {
    max-width: 360px;
    margin: 26px 0 0;
    color: rgba(248, 246, 239, .68);
    font-size: 1rem;
    line-height: 1.55;
  }

  .footer-meta {
    margin: auto 0 0;
    padding-top: 64px;
    color: rgba(248, 246, 239, .48);
    font-family: var(--mono, "IBM Plex Mono", monospace);
    font-size: .65rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .footer-map {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 80px);
  }

  .footer-group h2 {
    margin: 0 0 28px;
    color: var(--paper-bright, #f8f6ef);
    font-family: var(--mono, "IBM Plex Mono", monospace);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .footer-group ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group a {
    display: inline-block;
    color: rgba(248, 246, 239, .72);
    font-size: .95rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 160ms ease, transform 160ms ease;
  }

  .footer-group a:hover {
    color: var(--blue, #1557ff);
    transform: translateX(3px);
  }

  .footer-group a:focus-visible {
    color: var(--paper-bright, #f8f6ef);
    outline: 3px solid currentColor;
    outline-offset: 4px;
    box-shadow: 0 0 0 7px var(--blue, #1557ff);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 900px) {
    .site-footer { grid-template-columns: 1fr; }
    .footer-meta { margin-top: 0; padding-top: 36px; }
  }

  @media (max-width: 620px) {
    .footer-map { grid-template-columns: 1fr; gap: 42px; }
    .footer-group h2 { margin-bottom: 20px; }
    .footer-group ul { gap: 4px; }
    .footer-group a { min-height: 44px; display: inline-flex; align-items: center; padding-block: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-group a { transition: none; }
  }
</style>
