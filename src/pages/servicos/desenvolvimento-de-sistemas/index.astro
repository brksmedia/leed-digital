---
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import EditorialPage from '../../../components/EditorialPage.astro'
import PageCta from '../../../components/PageCta.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { breadcrumbJsonLd, serviceJsonLd } from '../../../lib/structured-data'

const path = '/servicos/desenvolvimento-de-sistemas/'
const title = 'Desenvolvimento de sistemas sob medida | LEED Digital'
const description = 'Sistemas sob medida para operações empresariais que precisam organizar processos, regras, dados, equipes e decisões em um fluxo confiável.'
const crumbs = [{ label: 'Início', path: '/' }, { label: 'Serviços', path: '/#capabilities' }, { label: 'Desenvolvimento de sistemas', path }]
---

<BaseLayout title={title} description={description} path={path} jsonLd={[serviceJsonLd('Desenvolvimento de sistemas sob medida', description, path), breadcrumbJsonLd(crumbs)]}>
  <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Serviços', href: '/#capabilities' }, { label: 'Desenvolvimento de sistemas' }]} />
  <EditorialPage eyebrow="SERVIÇO / SISTEMAS" title="Software desenhado em torno da operação." intro="Quando ferramentas prontas fragmentam o trabalho, um sistema próprio pode reunir contexto, regras e responsabilidades sem obrigar a empresa a operar nos limites de vários produtos.">
    <section class="content-grid">
      <article class="content-card"><span class="number-label">01</span><h2>Ferramentas internas</h2><p>Aplicações para equipes executarem rotinas, acompanharem exceções e registrarem decisões no mesmo fluxo.</p></article>
      <article class="content-card"><span class="number-label">02</span><h2>Portais</h2><p>Ambientes para clientes, parceiros ou fornecedores acessarem o que precisam sem gerar retrabalho interno.</p></article>
      <article class="content-card"><span class="number-label">03</span><h2>Produtos operacionais</h2><p>Camadas digitais que transformam conhecimento disperso em uma operação consistente e evolutiva.</p></article>
      <article class="content-card wide"><span class="number-label">BOM SINAL</span><h3>O processo exige contexto compartilhado</h3><p>Várias pessoas precisam reconstruir a mesma história em planilhas, mensagens e sistemas distintos para tomar uma decisão.</p><a href="/insights/">Acompanhar análises</a></article>
      <article class="content-card wide"><span class="number-label">EVITAMOS</span><h3>Digitalizar um fluxo ruim sem questioná-lo</h3><p>Antes da implementação, separamos complexidade necessária de etapas que existem apenas por limitações das ferramentas atuais.</p><a href="/como-trabalhamos/">Ver como trabalhamos</a></article>
    </section>
  </EditorialPage>
  <PageCta />
</BaseLayout>
